<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>2.1.0</Version>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icons\icon.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(SelfContained)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="beeps\**\*.mp3" />
    <Resource Include="beeps\**\*.wav" />
  </ItemGroup>

  <Target Name="ZipPublishOutput" AfterTargets="Publish">
    <PropertyGroup>
      <_ZipOutputPath>$(PublishDir)..\Timer.zip</_ZipOutputPath>
    </PropertyGroup>
    <Delete Files="$(_ZipOutputPath)" Condition="Exists('$(_ZipOutputPath)')" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Compress-Archive -Path &apos;$(PublishDir)*&apos; -DestinationPath &apos;$(_ZipOutputPath)&apos; -Force&quot;" />
  </Target>

</Project>
