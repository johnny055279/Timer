<Window x:Class="Timer.TwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Twitch Settings (Twitch 設定)"
        Width="760"
        Height="760"
        MinWidth="620"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#F6F2EA">
    <Grid Margin="20">
        <Border CornerRadius="12" Background="#FFFDF8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Twitch (Twitch)" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="TwitchStatusTextBlock" Text="Not connected (未連線)" Margin="0,0,0,8" />
                    <StackPanel x:Name="TwitchConnectPanel">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="TwitchConnectButton" Content="Connect Twitch (連線)" MinWidth="150" Click="TwitchConnectButton_Click" />
                            <Button Content="Reset Twitch (重置)" MinWidth="150" Click="TwitchReset_Click" Margin="0" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Verification code (驗證碼)" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TwitchUserCodeTextBlock"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button Grid.Column="1" Content="Copy (複製)" MinWidth="110" Click="TwitchCopyCode_Click" Margin="0" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Verification URL (驗證網址)" />
                            <TextBlock x:Name="TwitchVerifyUrlTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="#6C757D" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Channel points (redemptions) (小奇點兌換)" Margin="0,0,0,6" />
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Load rewards (載入)" MinWidth="160" Click="TwitchLoadRewards_Click" />
                            <Button Content="Copy reward ID (複製)" MinWidth="190" Click="TwitchCopyRewardId_Click" Margin="0" />
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Reward (獎勵)" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                            <ComboBox x:Name="TwitchRewardsComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="TwitchRewardsComboBox_SelectionChanged" />
                            <ComboBox x:Name="TwitchRewardActionComboBox" Grid.Row="0" Grid.Column="2" MinWidth="120" HorizontalAlignment="Stretch" Margin="10,0,0,0" />
                            <TextBox x:Name="TwitchRewardMinutesTextBox"
                                     Grid.Row="0"
                                     Grid.Column="3"
                                     Margin="10,0,0,0"
                                     MinWidth="60"
                                     Text="1"
                                     InputScope="Number"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"
                                     PreviewKeyDown="NumericOnly_PreviewKeyDown" />
                            <Button Content="Add (新增)" Grid.Row="0" Grid.Column="4" MinWidth="110" Click="TwitchAddRewardMapping_Click" Margin="0" />

                            <TextBlock Text="Reward ID (獎勵ID)" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0" />
                            <TextBox x:Name="TwitchRewardIdTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" IsReadOnly="True" HorizontalAlignment="Stretch" />

                            <TextBlock Text="Mappings (對應)" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,8,0,0" />
                            <ListBox x:Name="TwitchRewardMappingsListBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" MinHeight="80" HorizontalAlignment="Stretch" />
                            <Button Content="Remove (移除)" Grid.Row="2" Grid.Column="2" MinWidth="120" HorizontalAlignment="Left" Margin="10,8,0,0" Click="TwitchRemoveRewardMapping_Click" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Polls (agree / disagree) (投票)" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Poll title (投票標題)" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBox x:Name="TwitchPollTitleTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" HorizontalAlignment="Stretch" />

                        <TextBlock Text="Minutes (分鐘)" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0" />
                        <TextBox x:Name="TwitchPollMinutesTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,4,0,0"
                                 MinWidth="60"
                                 Text="5"
                                 InputScope="Number"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 PreviewKeyDown="NumericOnly_PreviewKeyDown" />
                        <ComboBox x:Name="TwitchPollActionComboBox" Grid.Row="1" Grid.Column="2" MinWidth="120" Margin="10,4,0,0" HorizontalAlignment="Stretch" />
                        <Button Content="Start poll (開始)" Grid.Row="1" Grid.Column="3" MinWidth="130" Margin="10,4,0,0" Click="TwitchStartPoll_Click" />

                        <TextBlock x:Name="TwitchPollStatusTextBlock" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Text="No poll started (尚未開始)" Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
