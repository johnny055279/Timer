<Window x:Class="Timer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Timer"
        mc:Ignorable="d"
        Title="Timer" Height="650" SizeToContent="Width" ResizeMode="NoResize" Background="#F6F2EA"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#FFFDF8"
                BorderBrush="#E9ECEF"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <TextBlock Text="Timer (計時器)" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="TwitchConnectedBadge"
                            Background="#1B5E20"
                            CornerRadius="10"
                            Padding="8,4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock Text="Twitch connected"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                    <Button Content="Twitch (設定)" MinWidth="120" Click="TwitchButton_Click" />
                    <Button Content="Help (說明)" MinWidth="110" Click="HelpButton_Click" />
                    <Button Content="Debug (除錯)" MinWidth="110" Margin="0" Click="DebugButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="TwitchTokenWarningBorder"
                Grid.Row="1"
                Background="#FFF3CD"
                BorderBrush="#FFECB5"
                BorderThickness="1"
                CornerRadius="6"
                Margin="20,12,20,0"
                Padding="12"
                Visibility="Collapsed">
            <TextBlock Text="Twitch not connected. Open Twitch settings to connect. (Twitch 未連線，請至設定連線)"
                       Foreground="#664D03"
                       FontWeight="SemiBold" />
        </Border>
        <Grid x:Name="MainGrid"
              Grid.Row="2"
              Margin="20"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
        <Border x:Name="FocusSink"
                Width="0"
                Height="0"
                Focusable="True"
                Opacity="0"
                IsHitTestVisible="False" />

        <Border Grid.Column="0" CornerRadius="12" Background="#FFFDF8" Padding="16" Margin="0,0,12,0">
            <StackPanel>
                <TextBox x:Name="CountdownTitleTextBox"
                         Text="Countdown timer (倒數計時器)"
                         FontSize="18"
                         FontWeight="SemiBold"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         TextChanged="CountdownTitleTextBox_TextChanged" />
                <TextBlock x:Name="TimeDisplayTextBlock"
                           Text="00:00:00"
                           FontSize="36"
                           FontWeight="Bold"
                           Margin="0,12,0,12"
                           HorizontalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button Content="- mins (減)" MinWidth="90" Click="DecreaseTime_Click" />
                    <Button Content="+ mins (加)" MinWidth="90" Click="IncreaseTime_Click" />
                    <Button Content="Reset (歸零)" MinWidth="90" Click="ResetCountdown_Click" />
                    <Button x:Name="PauseButton" Content="Pause (暫停)" MinWidth="100" Click="Pause_Click" Margin="0" />
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Minutes step (分鐘步進)" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="StepMinutesTextBox"
                                 Grid.Column="1"
                                 Text="5"
                                 MinWidth="60"
                                 InputScope="Number"
                                 TextChanged="StepMinutesTextBox_TextChanged"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 PreviewKeyDown="NumericOnly_PreviewKeyDown" />
                    </Grid>
                    <TextBlock x:Name="StepMinutesWarningTextBlock"
                               Text="Enter 1-120. (請輸入 1-120)"
                               Foreground="#DC3545"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Visibility="Collapsed" />
                </StackPanel>

                <Grid Margin="0,0,0,10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Select beep (提示音)" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="BeepComboBox"
                              Grid.Column="1"
                              MinWidth="160"
                              Margin="0,0,8,0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="BeepComboBox_SelectionChanged"
                              DropDownClosed="BeepComboBox_DropDownClosed" />
                    <Button Content="Play (播放)" Grid.Column="2" MinWidth="80" Click="PlayBeep_Click" />
                    <Button Content="Browse (選檔)" Grid.Column="3" MinWidth="90" Click="BrowseBeep_Click" Margin="0" />
                </Grid>

            </StackPanel>
        </Border>

        <Border Grid.Column="1" CornerRadius="12" Background="#FFFDF8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <TextBox x:Name="CounterTitleTextBox"
                         Text="Counter (計數器)"
                         FontSize="18"
                         FontWeight="SemiBold"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         TextChanged="CounterTitleTextBox_TextChanged" />
                <TextBlock x:Name="CounterValueTextBlock"
                               Text="0"
                               FontSize="36"
                               FontWeight="Bold"
                               Margin="0,12,0,12"
                               HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="IncreaseCounterButton" Content="+1" MinWidth="90" Click="IncreaseCounter_Click" />
                    <Button x:Name="DecreaseCounterButton" Content="-1" MinWidth="90" Click="DecreaseCounter_Click" />
                    <Button Content="Reset (歸零)" MinWidth="90" Click="ResetCounter_Click" Margin="0" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Step (步進)" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="CounterStepTextBox"
                                 Grid.Column="1"
                                 Text="1"
                                 MinWidth="60"
                                 InputScope="Number"
                                 TextChanged="CounterStepTextBox_TextChanged"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 PreviewKeyDown="NumericOnly_PreviewKeyDown" />
                    </Grid>
                <TextBlock x:Name="CounterStepWarningTextBlock"
                           Text="Enter 1-999. (請輸入 1-999)"
                                   Foreground="#DC3545"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <TextBlock Text="Hotkeys (click and press keys) (快捷鍵)" Margin="0,12,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Increase (增加)" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,8,6" />
                        <TextBox x:Name="IncreaseHotkeyTextBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Tag="Increase"
                                 Margin="0,0,0,6"
                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" />

                        <TextBlock Text="Decrease (減少)" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,6" />
                        <TextBox x:Name="DecreaseHotkeyTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Tag="Decrease"
                                 Margin="0,0,0,6"
                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" />

                        <TextBlock Text="Reset (歸零)" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="ResetHotkeyTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Tag="Reset"
                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" />
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        </Grid>
    </Grid>
</Window>

